package main

templ Aftercare() {
	@Page("Tattoo Aftercare | tat.it.too", "Tattoo aftercare instructions from tat.it.too, Chicago. How to care for your new tattoo, day by day, so it heals clean.", "https://www.tatit2.com/aftercare.html", "https://www.tatit2.com/aftercare.html") {
		<section class="page-hero page-hero--tall" aria-labelledby="care-title">
			<h1 id="care-title" class="h1-soft">Tattoo<br/>aftercare</h1>
			<div class="page-hero-intro">
				<p class="b-txt">Every tattoo heals a little differently. Follow this day by day and your piece will settle in clean and sharp.</p>
			</div>
		</section>
		<div class="care-rows">
			<section class="care-row" aria-labelledby="care-first">
				<h2 id="care-first" class="care-title">First days</h2>
				<ul class="care-list">
					<li>Keep the bandage on for 2–3 days.</li>
					<li>Do not swim, get sunburned, or sweat.</li>
					<li>After 3 days, take off the bandage in the shower.</li>
					<li>Pat dry with a clean paper towel (do not rub).</li>
					<li>Let it air out for about 10 minutes, then apply a thin layer of Aquaphor or a recommended tattoo ointment.</li>
					<li>Continue applying a thin layer of Aquaphor or tattoo healing ointment 2 times a day (thin layer only).</li>
					<li>Do not over-moisturize—your skin needs to breathe.</li>
				</ul>
			</section>
			<section class="care-row" aria-labelledby="care-week">
				<h2 id="care-week" class="care-title">Days 5–14</h2>
				<ul class="care-list">
					<li>Tattoo may start to peel or flake—this is normal. Do not pick or scratch.</li>
					<li>Switch to a fragrance-free lotion like Aveeno or Lubriderm instead of Aquaphor.</li>
					<li>Keep moisturizing to prevent excessive itching or scabbing.</li>
				</ul>
			</section>
			<section class="care-row" aria-labelledby="care-avoid">
				<h2 id="care-avoid" class="care-title">Avoid</h2>
				<ul class="care-list">
					<li>No swimming, saunas, or soaking (including baths) for at least 2 weeks.</li>
					<li>No direct sunlight or tanning on the tattoo until fully healed.</li>
					<li>No tight clothing rubbing against the tattoo.</li>
					<li>Do not apply alcohol, peroxide, Vaseline, or scented products.</li>
				</ul>
			</section>
			<section class="care-row" aria-labelledby="care-time">
				<h2 id="care-time" class="care-title">Healing time</h2>
				<ul class="care-list">
					<li>Healing usually takes 2–4 weeks, depending on your skin and tattoo size.</li>
				</ul>
			</section>
		</div>
	}
}
