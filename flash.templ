package main

type flashDesign struct {
	ID    string // file name without extension, e.g. flash-15; also what the booking email reports
	Taken bool
}

var newFlash = []flashDesign{
	{"flash-15", false},
	{"flash-16", false},
	{"flash-17", true},
	{"flash-18", true},
}

var oldFlash = []flashDesign{
	{"flash-01", true},
	{"flash-02", false},
	{"flash-03", true},
	{"flash-04", false},
	{"flash-05", true},
	{"flash-06", false},
	{"flash-07", false},
	{"flash-08", false},
	{"flash-09", true},
	{"flash-10", true},
	{"flash-11", false},
	{"flash-12", false},
	{"flash-13", false},
	{"flash-14", true},
}

func flashStatus(d flashDesign) string {
	if d.Taken {
		return "claimed"
	}
	return "available"
}

func flashCardClass(d flashDesign) string {
	if d.Taken {
		return "flash-card flash-card--taken"
	}
	return "flash-card"
}

templ FlashCard(d flashDesign) {
	<button type="button" class={ flashCardClass(d) } data-status={ flashStatus(d) } data-src={ "images/flash/" + d.ID + ".webp" } data-id={ d.ID } aria-label={ "View flash design, " + flashStatus(d) }>
		<span class="flash-card-img">@Pic("images/flash/" + d.ID + ".webp", "", "(max-width: 767px) 50vw, (max-width: 991px) 33vw, (max-width: 1279px) 25vw, 20vw", false)</span>
		<span class="flash-card-meta"><span class="flash-card-status">{ flashStatus(d) }</span></span>
	</button>
}

templ Flash() {
	@Page("Flash Tattoos in Chicago | tat.it.too", "Browse flash tattoo designs by tat.it.too, Chicago tattoo artist at Sappe Sin Studio. Pre-drawn designs ready to book.", "https://www.tatit2.com/flash.html", "https://www.tatit2.com/flash.html") {
		<section class="page-hero" aria-labelledby="flash-title">
			<h1 id="flash-title" class="display h1-page">Flash</h1>
			<p class="page-hero-blurb">Pre-drawn designs, ready to book. Pick one, send a placement photo, and it's yours.</p>
		</section>
		<div class="flash-filters" role="group" aria-label="Filter designs">
			<button type="button" class="flash-filter is-active" data-filter="all" aria-pressed="true"><span class="ring" aria-hidden="true"></span>All <span class="count" data-count="all"></span></button>
			<button type="button" class="flash-filter" data-filter="available" aria-pressed="false"><span class="ring" aria-hidden="true"></span>Available <span class="count" data-count="available"></span></button>
			<button type="button" class="flash-filter" data-filter="claimed" aria-pressed="false"><span class="ring" aria-hidden="true"></span>Claimed <span class="count" data-count="claimed"></span></button>
		</div>
		<section class="flash-group" aria-labelledby="new-flash">
			<div class="flash-group-label"><span class="dot" aria-hidden="true"></span><span id="new-flash" class="label label--ink">New flash</span></div>
			<div class="flash-grid">
				for _, d := range newFlash {
					@FlashCard(d)
				}
			</div>
		</section>
		<section class="flash-group" aria-labelledby="old-flash">
			<div class="flash-group-label"><span class="dot" aria-hidden="true"></span><span id="old-flash" class="label label--ink">Old flash</span></div>
			<div class="flash-grid">
				for _, d := range oldFlash {
					@FlashCard(d)
				}
			</div>
		</section>
		<p class="flash-empty b-txt" id="flash-empty" hidden>Nothing here right now.</p>
		<div id="flash-modal" class="flash-modal" role="dialog" aria-modal="true" aria-label="View flash design" aria-hidden="true" hidden>
			<div class="flash-modal-backdrop" aria-hidden="true"></div>
			<div class="flash-modal-inner">
				<button type="button" class="flash-modal-close" aria-label="Close">Close <span aria-hidden="true">×</span></button>
				<div class="flash-modal-image">
					<img id="flash-modal-img" class="flash-modal-img" src="" alt=""/>
				</div>
				<a href="book.html" id="flash-modal-cta" class="flash-modal-cta"><span>Book this design</span>@Arrow()</a>
				<span id="flash-modal-taken" class="flash-modal-taken" hidden><span>Claimed</span><span>No longer available</span></span>
			</div>
		</div>
		<script>
			(function() {
				var cards = Array.prototype.slice.call(document.querySelectorAll('.flash-card'));
				var filters = document.querySelectorAll('.flash-filter');
				var groups = document.querySelectorAll('.flash-group');
				var empty = document.getElementById('flash-empty');
				var counts = { all: cards.length, available: 0, claimed: 0 };
				cards.forEach(function(c) { counts[c.getAttribute('data-status')]++; });
				document.querySelectorAll('[data-count]').forEach(function(el) {
					el.textContent = String(counts[el.getAttribute('data-count')]).padStart(2, '0');
				});
				function applyFilter(f) {
					filters.forEach(function(b) {
						var on = b.getAttribute('data-filter') === f;
						b.classList.toggle('is-active', on);
						b.setAttribute('aria-pressed', String(on));
					});
					cards.forEach(function(c) {
						c.classList.toggle('is-hidden', f !== 'all' && c.getAttribute('data-status') !== f);
					});
					groups.forEach(function(g) {
						g.hidden = !g.querySelector('.flash-card:not(.is-hidden)');
					});
					if (empty) empty.hidden = f === 'all' || counts[f] > 0;
				}
				filters.forEach(function(b) {
					b.addEventListener('click', function() { applyFilter(b.getAttribute('data-filter')); });
				});

				var modal = document.getElementById('flash-modal');
				if (!modal) return;
				var closeBtn = modal.querySelector('.flash-modal-close');
				var cta = document.getElementById('flash-modal-cta');
				var takenLabel = document.getElementById('flash-modal-taken');
				var img = document.getElementById('flash-modal-img');
				var lastFocused = null;
				var openedViaKeyboard = false;
				function openModal(trigger, viaKeyboard) {
					lastFocused = trigger || document.activeElement;
					openedViaKeyboard = !!viaKeyboard;
					var src = trigger.getAttribute('data-src');
					if (img && src) { img.src = src; img.alt = 'Flash design'; }
					var isTaken = trigger.getAttribute('data-status') === 'claimed';
					if (cta) {
						cta.hidden = isTaken;
						cta.href = 'book.html?type=Flash&design=' + encodeURIComponent(trigger.getAttribute('data-id') || '') + '&src=' + encodeURIComponent(trigger.getAttribute('data-src') || '');
					}
					if (takenLabel) takenLabel.hidden = !isTaken;
					modal.removeAttribute('hidden');
					modal.setAttribute('aria-hidden', 'false');
					document.body.style.overflow = 'hidden';
					closeBtn && closeBtn.focus();
				}
				function closeModal() {
					modal.setAttribute('hidden', '');
					modal.setAttribute('aria-hidden', 'true');
					document.body.style.overflow = '';
					if (openedViaKeyboard && lastFocused && lastFocused.focus) {
						lastFocused.focus();
					} else if (document.activeElement && document.activeElement.blur) {
						document.activeElement.blur();
					}
				}
				cards.forEach(function(btn) {
					btn.addEventListener('mouseenter', function() {
						var src = btn.getAttribute('data-src');
						if (src) { var preload = new Image(); preload.src = src; }
					});
					btn.addEventListener('click', function() { openModal(this, false); });
					btn.addEventListener('keydown', function(e) {
						if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(this, true); }
					});
				});
				modal.querySelector('.flash-modal-backdrop').addEventListener('click', closeModal);
				closeBtn && closeBtn.addEventListener('click', closeModal);
				modal.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });
			})();
		</script>
	}
}
