package main

templ NotFound() {
	@Page("Page not found | tat.it.too", "tat.it.too – Custom tattoos and flash. Book your appointment online.", "", "https://www.tatit2.com/") {
		<section class="page-hero page-hero--mid" aria-labelledby="not-found-heading">
			<h1 id="not-found-heading" class="display h1-hero">404</h1>
		</section>
		<div class="util-body">
			<div class="label label--ink">Page not found</div>
			<div class="util-text">
				<p class="b-txt">That page doesn't exist, or it moved.</p>
				<a class="back-home arrow-link" href="index.html"><span>Back home</span>@Arrow()</a>
			</div>
		</div>
	}
}
