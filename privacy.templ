package main

templ Privacy() {
	@Page("Privacy | tat.it.too", "What tat.it.too collects when you send a booking request, where it goes, and how to have it removed.", "https://www.tatit2.com/privacy.html", "https://www.tatit2.com/privacy.html") {
		<section class="page-hero page-hero--mid" aria-labelledby="privacy-heading">
			<h1 id="privacy-heading" class="h1-soft">Privacy</h1>
			<p class="page-hero-blurb">Last updated October 7, 2026</p>
		</section>
		<div class="care-rows">
			<section class="care-row" aria-labelledby="pv-collect">
				<h2 id="pv-collect" class="care-title">What I collect</h2>
				<ul class="care-list">
					<li>When you send a booking request: your name, email, phone number, preferred day, the details of the tattoo you want, and any photos you upload (references, the placement area, your pet).</li>
					<li>Nothing else. This site sets no cookies of its own and runs no analytics or advertising.</li>
				</ul>
			</section>
			<section class="care-row" aria-labelledby="pv-goes">
				<h2 id="pv-goes" class="care-title">Where it goes</h2>
				<ul class="care-list">
					<li>The form is delivered to my inbox by FormSubmit, which forwards it by email and does not keep a copy beyond delivery.</li>
					<li>The booking page uses Google reCAPTCHA to block spam. It loads only once you start filling in the form, and Google may collect device information and set cookies under the <a class="inline-link" href="https://policies.google.com/privacy" rel="noopener noreferrer" target="_blank">Google Privacy Policy</a> and <a class="inline-link" href="https://policies.google.com/terms" rel="noopener noreferrer" target="_blank">Terms of Service</a>.</li>
					<li>I never sell or share your details, and I don't use your photos for anything other than planning your tattoo.</li>
				</ul>
			</section>
			<section class="care-row" aria-labelledby="pv-keep">
				<h2 id="pv-keep" class="care-title">How long I keep it</h2>
				<ul class="care-list">
					<li>As long as it takes to arrange and complete your tattoo, and for follow-up questions about healing.</li>
					<li>Want it deleted sooner? Message me on <a class="inline-link" href="https://www.instagram.com/tat.it.too/" rel="noopener noreferrer" target="_blank">Instagram</a> and I'll remove your request and photos.</li>
				</ul>
			</section>
		</div>
	}
}
