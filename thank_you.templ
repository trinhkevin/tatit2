package main

templ ThankYou() {
	@Page("Thank You | tat.it.too", "Thanks for your booking request. tat.it.too will be in touch soon.", "https://www.tatit2.com/thank_you.html", "https://www.tatit2.com/thank_you.html") {
		<section class="page-hero page-hero--mid" aria-labelledby="thank-you-heading">
			<h1 id="thank-you-heading" class="display h1-page">Thank<br/>you</h1>
		</section>
		<div class="util-body">
			<div class="label label--ink">Your request is in</div>
			<div class="util-text">
				<p class="b-txt">If you have any questions, or need any details, feel free to let me know.</p>
				<p class="b-txt">I will get back to you as soon as possible. Thank you for your patience 🖤</p>
				<a class="back-home arrow-link" href="index.html"><span>Back home</span>@Arrow()</a>
			</div>
		</div>
	}
}
